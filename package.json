{
  "name": "context-circuit-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.8.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "browser:check": "tsx scripts/verify-browser.ts",
    "build": "pnpm theme:check && next build",
    "dev": "next dev",
    "lint": "eslint .",
    "postinstall": "fumadocs-mdx",
    "static:check": "tsx scripts/check-static-export.ts",
    "test": "tsx scripts/run-tests.ts",
    "theme:check": "tsx scripts/check-theme.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
